{
  "name": "chatify-backend",
  "version": "1.0.0",
  "description": "REST API and Socket.IO server for the Chatify real-time chat app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:dev": "npm run dev",
    "build": "npm install",
    "lint": "eslint .",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "keywords": [
